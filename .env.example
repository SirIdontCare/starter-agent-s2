# Skopiuj ten plik jako .env.local (obok package.json) i uzupelnij wartosci.
#
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   Mac / Linux:           cp .env.example .env.local
#
# Pliku .env.local nie wysylasz nikomu i nie wrzucasz na GitHub.

# --- Model AI (OpenRouter) --------------------------------
# Klucz z prywatnej wiadomosci od LABA — ten sam co w kursie
OPENROUTER_API_KEY=

# Model do rozmowy (przelacznik "Standard" w czacie). Pelny identyfikator z openrouter.ai/models.
OPENROUTER_MODEL=openai/gpt-6-luna

# Opcjonalnie: mocniejszy model pod przelacznikiem "Pro". Bez tej linii Pro = Standard.
# OPENROUTER_MODEL_PRO=anthropic/claude-sonnet-5.5

# Opcjonalnie: model do generowania grafik i model embeddingow bazy wiedzy.
# Domyslne wartosci sa wpisane w lib/openrouter.ts. Model embeddingow musi
# zwracac 768 wymiarow — inaczej trzeba zmienic vector(768) w supabase/schema.sql.
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2

# --- Baza danych (NOWY, osobny projekt Supabase) ----------
# Settings -> API w nowym projekcie — nie w tym z kursu glownego.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
